{
  "name": "obsidian-pi-plugin",
  "version": "0.0.1",
  "private": true,
  "description": "A local wterm terminal for Pi, inside Obsidian.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "install-to": "node scripts/install-to-vault.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wterm/dom": "0.4.1",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^22.0.0",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
